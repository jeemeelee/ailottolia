# Set these in Vercel, never in public HTML. Use separate Preview storage/secrets.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_ORIGIN=https://ailottolia.vercel.app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel Analytics; server token is never included in public files.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
# Exact same-origin script path shown in the project's Analytics setup.
VERCEL_ANALYTICS_SCRIPT_PATH=
